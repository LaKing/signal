+//! M2.10-4 AC6 measurement only (docs/measurements/m2.10-4-cycle-timing.patch):
+//! never part of the delivered engine. Section totals of the per-frame call
+//! path of a cycle member, timed with `Instant`, one section per run
+//! (`SIGNAL_PROF_SECTION`), printed by `signal render` at the end.
+
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::Instant;
+
+/// The sections: 0 a cycle's frame (all members), 1 view, 2 gather,
+/// 3 load_call and start_call, 4 guarded (process included), 5 process
+/// (the `dyn` call and the primitive's work), 6 commit and keep_events,
+/// 7 a cycle's state-output emits and absorbs, 8 an empty section (timer
+/// calibration, next to section 1's point).
+pub const NAMES: [&str; 9] = [
+    "cycle frame",
+    "view (access.call)",
+    "gather",
+    "load_call + start_call",
+    "guarded (incl. process)",
+    "process (dyn call + primitive)",
+    "commit + keep_events",
+    "state emits + absorbs",
+    "empty (timer)",
+];
+
+static NANOS: [AtomicU64; 9] = [const { AtomicU64::new(0) }; 9];
+static COUNT: [AtomicU64; 9] = [const { AtomicU64::new(0) }; 9];
+static SECTION: OnceLock<usize> = OnceLock::new();
+
+fn section() -> usize {
+    *SECTION.get_or_init(|| {
+        std::env::var("SIGNAL_PROF_SECTION")
+            .ok()
+            .and_then(|s| s.parse().ok())
+            .unwrap_or(usize::MAX)
+    })
+}
+
+/// A start time if `s` is the section timed in this run.
+#[inline(always)]
+pub fn start(s: usize) -> Option<Instant> {
+    (section() == s).then(Instant::now)
+}
+
+/// Adds the time since `t` to section `s`.
+#[inline(always)]
+pub fn stop(s: usize, t: Option<Instant>) {
+    if let Some(t) = t {
+        NANOS[s].fetch_add(t.elapsed().as_nanos() as u64, Ordering::Relaxed);
+        COUNT[s].fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// Prints the timed section's total, count and mean.
+pub fn report() {
+    for s in 0..NAMES.len() {
+        let n = COUNT[s].load(Ordering::Relaxed);
+        if n > 0 {
+            let ns = NANOS[s].load(Ordering::Relaxed);
+            eprintln!(
+                "PROF section {s} {}: {n} calls, {ns} ns, {:.2} ns per call",
+                NAMES[s],
+                ns as f64 / n as f64
+            );
+        }
+    }
+}
