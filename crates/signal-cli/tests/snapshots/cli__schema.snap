---
source: crates/signal-cli/tests/cli.rs
expression: text
---
{
  "$defs": {
    "CompositeFile": {
      "additionalProperties": false,
      "description": "A Signal composite file, `composites/<name>.toml`.",
      "properties": {
        "composite": {
          "$ref": "#/$defs/CompositeSection",
          "description": "The composite's name."
        },
        "exports": {
          "$ref": "#/$defs/ExportsSection",
          "description": "What the composite exposes to the instance that uses it."
        },
        "instances": {
          "additionalProperties": {
            "$ref": "#/$defs/InstanceEntry"
          },
          "description": "The module instances, by name.",
          "type": "object"
        },
        "schema_version": {
          "const": 1,
          "description": "The format version of this file; this version of Signal reads 1.",
          "type": "integer"
        },
        "wiring": {
          "$ref": "#/$defs/Wiring",
          "description": "The connections between instances."
        }
      },
      "required": [
        "schema_version",
        "composite"
      ],
      "type": "object"
    },
    "CompositeSection": {
      "additionalProperties": false,
      "description": "`[composite]`.",
      "properties": {
        "category": {
          "default": null,
          "description": "The palette group (ADR 0027 §1: `core`, `generator`, `filter`,\n`envelope`, `delay`, `physical`, `event`, `visual`, `io`), as a\nprimitive type's descriptor has one. Required in a library composite.",
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "default": null,
          "description": "What the composite does and what each export means. Required in a\nlibrary composite.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "The composite's name: its file name without `.toml`, used as the module\nreference of its instances.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "ConnectionEntry": {
      "additionalProperties": false,
      "description": "One connection.",
      "properties": {
        "from": {
          "description": "The source output port, `instance.port`.",
          "type": "string"
        },
        "scale": {
          "description": "The factor applied to a signal source; 1 when absent.",
          "format": "double",
          "type": "number"
        },
        "to": {
          "description": "The target input port or parameter, `instance.port`.",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "ExportsSection": {
      "additionalProperties": false,
      "description": "`[exports]`.",
      "properties": {
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/Targets"
          },
          "description": "Exported inputs: each maps to one inner input port or a list of them.",
          "type": "object"
        },
        "outputs": {
          "additionalProperties": {
            "$ref": "#/$defs/OutputTarget"
          },
          "description": "Exported outputs: each maps to exactly one inner output port.",
          "type": "object"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/Targets"
          },
          "description": "Exported parameters: each maps to one inner parameter or a list of them.",
          "type": "object"
        }
      },
      "type": "object"
    },
    "InstanceEntry": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "An instance: its module, the GPU device it is pinned to (`gpu`, a device id or index; GPU-backed instances only), the pattern whose data it takes (`pattern`, the name of patterns/<name>.toml; types that take one only), and the parameter values set on it.",
      "properties": {
        "gpu": {
          "minLength": 1,
          "type": "string"
        },
        "module": {
          "$ref": "#/$defs/ModuleRef"
        },
        "pattern": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        }
      },
      "required": [
        "module"
      ],
      "type": "object"
    },
    "ModuleRef": {
      "anyOf": [
        {
          "enum": [
            "std.abs",
            "std.add",
            "std.adsr",
            "std.allpass_delay",
            "std.and",
            "std.atan2",
            "std.audio_out",
            "std.biquad",
            "std.body2d",
            "std.buffer1k",
            "std.buffer1m",
            "std.buffer64k",
            "std.clamp",
            "std.clock_div",
            "std.comb",
            "std.compare",
            "std.const",
            "std.cos",
            "std.count",
            "std.counter",
            "std.dc_block",
            "std.delay",
            "std.div",
            "std.edge",
            "std.exciter",
            "std.exp",
            "std.exp_env",
            "std.fdn_reverb",
            "std.floor",
            "std.fm_op",
            "std.fract",
            "std.frames",
            "std.gain",
            "std.index1024",
            "std.index16",
            "std.index2",
            "std.index256",
            "std.index4",
            "std.index64",
            "std.index8",
            "std.integrator",
            "std.ladder",
            "std.lag",
            "std.latch",
            "std.lfo",
            "std.log",
            "std.mass_spring",
            "std.max",
            "std.mesh2d",
            "std.mesh2d_audio",
            "std.min",
            "std.mix",
            "std.mod",
            "std.modal",
            "std.mul",
            "std.neg",
            "std.noise",
            "std.not",
            "std.note_seq",
            "std.onepole",
            "std.or",
            "std.osc",
            "std.pack1024",
            "std.pack16",
            "std.pack2",
            "std.pack256",
            "std.pack4",
            "std.pack64",
            "std.pack8",
            "std.pan",
            "std.particles",
            "std.phasor",
            "std.playhead",
            "std.pow",
            "std.random",
            "std.reduce1024",
            "std.reduce16",
            "std.reduce2",
            "std.reduce256",
            "std.reduce4",
            "std.reduce64",
            "std.reduce8",
            "std.round",
            "std.route",
            "std.sample_hold",
            "std.sample_rate",
            "std.scale",
            "std.select",
            "std.sign",
            "std.sin",
            "std.sin_cycles",
            "std.sine_osc",
            "std.sqrt",
            "std.step_seq",
            "std.step_seq8",
            "std.string",
            "std.sub",
            "std.svf",
            "std.table1024",
            "std.table16",
            "std.table2",
            "std.table256",
            "std.table4",
            "std.table64",
            "std.table8",
            "std.tan",
            "std.tanh",
            "std.tanh_shaper",
            "std.to_events",
            "std.transport",
            "std.unit_delay",
            "std.unpack1024",
            "std.unpack16",
            "std.unpack2",
            "std.unpack256",
            "std.unpack4",
            "std.unpack64",
            "std.unpack8",
            "std.vadd1024",
            "std.vadd16",
            "std.vadd2",
            "std.vadd256",
            "std.vadd4",
            "std.vadd64",
            "std.vadd8",
            "std.vmul1024",
            "std.vmul16",
            "std.vmul2",
            "std.vmul256",
            "std.vmul4",
            "std.vmul64",
            "std.vmul8",
            "std.wavetable"
          ]
        },
        {
          "enum": [
            "lib.adsr_core",
            "lib.analog_clap",
            "lib.analog_cymbal",
            "lib.analog_hat",
            "lib.analog_kick",
            "lib.analog_rim",
            "lib.analog_snare",
            "lib.analog_tom",
            "lib.ar_env",
            "lib.crossfade",
            "lib.delay_core",
            "lib.ladder_voice",
            "lib.lag_core",
            "lib.lfo_shapes",
            "lib.modal_voice",
            "lib.onepole_core",
            "lib.osc_core",
            "lib.stereo_width",
            "lib.svf_core",
            "lib.tanh_shaper_core",
            "lib.tape_echo",
            "lib.transport"
          ]
        },
        {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        }
      ],
      "description": "A module reference: a registered primitive type, a library composite (lib.<name>, ADR 0027 §4), or the name of a composite in composites/<name>.toml."
    },
    "NoteEntry": {
      "additionalProperties": false,
      "description": "One note.",
      "properties": {
        "key": {
          "description": "The key, an integer from 0 to 127 (60 = middle C by the library's\nconvention).",
          "format": "int64",
          "maximum": 127,
          "minimum": 0,
          "type": "integer"
        },
        "length": {
          "description": "How long it sounds, in beats, above 0.",
          "format": "double",
          "minimum": 0.0,
          "type": "number"
        },
        "start": {
          "description": "Where it starts, in beats from the pattern's start, at least 0.",
          "format": "double",
          "minimum": 0.0,
          "type": "number"
        },
        "velocity": {
          "description": "Its velocity, from 0 to 1.",
          "format": "double",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "key",
        "start",
        "length",
        "velocity"
      ],
      "type": "object"
    },
    "NotesFile": {
      "additionalProperties": false,
      "description": "A note pattern file (`kind = \"notes\"`).",
      "properties": {
        "kind": {
          "const": "notes",
          "description": "`\"notes\"`.",
          "type": "string"
        },
        "length": {
          "description": "The loop length in beats, above 0 and at most 65536.",
          "format": "double",
          "maximum": 65536.0,
          "minimum": 0.0,
          "type": "number"
        },
        "notes": {
          "description": "The notes, in any order (required; `notes = []` for none): an\ninline array of tables or `[[notes]]` tables.",
          "items": {
            "$ref": "#/$defs/NoteEntry"
          },
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "description": "The format version of this file; this version of Signal reads 1.",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "length",
        "notes"
      ],
      "type": "object"
    },
    "OutputTarget": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string"
            },
            "group": {
              "type": "string"
            }
          },
          "required": [
            "from"
          ],
          "type": "object"
        }
      ],
      "description": "One inner output port `instance.port`, or a table with it as `from` and the schematic's `group` of the export."
    },
    "ProjectFile": {
      "additionalProperties": false,
      "description": "A Signal project file, `project.toml`.",
      "properties": {
        "instances": {
          "additionalProperties": {
            "$ref": "#/$defs/InstanceEntry"
          },
          "description": "The module instances, by name.",
          "type": "object"
        },
        "project": {
          "$ref": "#/$defs/ProjectSection",
          "description": "The project's name and run settings."
        },
        "schema_version": {
          "const": 1,
          "description": "The format version of this file; this version of Signal reads 1.",
          "type": "integer"
        },
        "wiring": {
          "$ref": "#/$defs/Wiring",
          "description": "The connections between instances."
        }
      },
      "required": [
        "schema_version",
        "project"
      ],
      "type": "object"
    },
    "ProjectSection": {
      "additionalProperties": false,
      "description": "`[project]`.",
      "properties": {
        "name": {
          "description": "The project's name.",
          "type": "string"
        },
        "sample_rate": {
          "default": 96000,
          "description": "The sample rate in frames per second.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "seed": {
          "default": 0,
          "description": "The master seed of every random stream.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "StepsFile": {
      "additionalProperties": false,
      "description": "A step pattern file (`kind = \"steps\"`).",
      "properties": {
        "kind": {
          "const": "steps",
          "description": "`\"steps\"`.",
          "type": "string"
        },
        "lanes": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "The lanes, in output order: `name = \"x...X...\"`, one cell per step\n(`.` rest, `x` hit, `X` accent).",
          "type": "object"
        },
        "levels": {
          "additionalProperties": {
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "number"
          },
          "default": {},
          "description": "The lanes' levels, `name = 0.9`, each from 0 to 1; every key names a\nlane, and a lane not listed has level 1.",
          "type": "object"
        },
        "schema_version": {
          "const": 1,
          "description": "The format version of this file; this version of Signal reads 1.",
          "type": "integer"
        },
        "step": {
          "description": "The beats per step (0.25 for 16ths), above 0 and at most 64.",
          "format": "double",
          "maximum": 64.0,
          "minimum": 0.0,
          "type": "number"
        },
        "steps": {
          "description": "The number of steps, 1 to 256.",
          "format": "int64",
          "maximum": 256,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "steps",
        "step",
        "lanes"
      ],
      "type": "object"
    },
    "Targets": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        {
          "additionalProperties": false,
          "properties": {
            "group": {
              "type": "string"
            },
            "to": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                }
              ]
            }
          },
          "required": [
            "to"
          ],
          "type": "object"
        }
      ],
      "description": "One inner port `instance.port`, or a non-empty list of them (fan-out), or a table with them as `to` and the schematic's `group` of the export."
    },
    "Wiring": {
      "additionalProperties": false,
      "description": "`[wiring]`.",
      "properties": {
        "connections": {
          "description": "Connections from an output port to an input port or parameter.",
          "items": {
            "$ref": "#/$defs/ConnectionEntry"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/ProjectFile"
    },
    {
      "$ref": "#/$defs/CompositeFile"
    },
    {
      "$ref": "#/$defs/NotesFile"
    },
    {
      "$ref": "#/$defs/StepsFile"
    }
  ],
  "title": "Signal project, composite and pattern files"
}
